*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.pyo

# Virtual environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Django
db.sqlite3
*.sqlite3
staticfiles/
media/
local_settings.py

# Environment / secrets
.env
.env.local
.env.production
.env.staging
*.secret
secrets.json

# IDE & editors
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
*.sublime-project
*.sublime-workspace

# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V3
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Coverage / testing
.coverage
htmlcov/
.tox/
.pytest_cache/
coverage.xml
nosetests.xml

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Celery
celerybeat-schedule
celerybeat.pid

# Node (if any frontend tooling is added later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
